PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://os:os@localhost:5433/os?schema=public
JWT_SECRET=troque-este-segredo-local
JWT_EXPIRES_IN=8h
# Segredo compartilhado com a Lambda de autenticação por CPF (header X-Internal-Token).
INTERNAL_SERVICE_TOKEN=troque-este-token-interno

# Catalog (REST síncrono para preço dos itens)
CATALOG_BASE_URL=http://localhost:3002/api/catalog
CATALOG_TIMEOUT_MS=3000

# Mensageria (LocalStack em dev; na AWS os valores vêm do Terraform/CD)
MESSAGING_ENABLED=true
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
INBOX_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/oficina-os-inbox.fifo
CATALOG_COMMANDS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/oficina-catalog-inbox.fifo
BILLING_COMMANDS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/oficina-billing-inbox.fifo
EXECUTION_COMMANDS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/oficina-execution-inbox.fifo

# Observabilidade (vazio = desligado)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tc-fase4-os
